{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AERVOX_WEB_PORT", "AERVOX_DESKTOP_PORT"],
  "globalDependencies": ["tsconfig.base.json", "tsconfig.base.node.json"],
  "globalPassThroughEnv": [
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    "CI",
    "PNPM_CONFIG_SCRIPT_SHELL",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@aervox/live2d#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#test": {
      "dependsOn": ["^build"],
      "inputs": ["scripts/**", "aervox-intro/**", "aervox-mark.svg", "package.json"]
    },
    "@aervox/mobile#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../LICENSE"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts"
      ]
    },
    "@aervox/api#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts",
        "../../plugins/**"
      ]
    }
  }
}
