{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AERVOX_WEB_PORT", "AERVOX_DESKTOP_PORT"],
  "globalPassThroughEnv": [
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    "CI",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@aervox/live2d#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/mobile#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts"
      ]
    }
  }
}
