{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AERVOX_WEB_PORT", "AERVOX_DESKTOP_PORT", "AERVOX_NATIVE_RELEASE_PUBLIC_KEY"],
  "globalDependencies": ["tsconfig.base.json", "tsconfig.base.node.json", "scripts/vendor-chunks.ts", "scripts/project-env.sh", "patches/**", ".npmrc", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": [
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    "CI",
    "PNPM_CONFIG_SCRIPT_SHELL",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "@aervox/native-runtime#build": {"dependsOn": ["^build"], "outputs": ["dist/**", "!dist/bin/**"], "inputs": ["$TURBO_DEFAULT$", "../../native/protocol/**", "../../scripts/generate-native-protocol.mjs"]},
    "@aervox/native-runtime#test": {"dependsOn": ["build", "native:build"], "cache": false, "inputs": ["$TURBO_DEFAULT$", "../../native/protocol/**"]},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "outputLogs": "new-only"
    },
    "@aervox/ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@aervox/ui-host#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@aervox/plugin-companion-ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@aervox/plugin-panels-ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@aervox/plugin-proactive-ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@aervox/plugin-workbench-ui#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@aervox/live2d#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#test": {
      "dependsOn": ["^build"],
      "inputs": ["scripts/**", "aervox-intro/**", "aervox-mark.svg", "package.json"]
    },
    "@aervox/mobile#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../LICENSE"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "AERVOX_API_HOST",
        "AERVOX_API_URL",
        "AERVOX_AUTH_MODE",
        "AERVOX_AUTH_TOKEN",
        "AERVOX_ADMIN_IDS",
        "AERVOX_LOG_LEVEL",
        "AERVOX_LOG_FORMAT",
        "AERVOX_SESSION_ID",
        "AERVOX_LOOP_PROVIDER",
        "AERVOX_LOOP_DISPATCH",
        "AERVOX_LOOP_RESUME",
        "AERVOX_EMBEDDING_PROVIDER",
        "AERVOX_EMBEDDING_URL",
        "AERVOX_EMBEDDING_API_KEY",
        "AERVOX_EMBEDDING_MODEL",
        "AERVOX_LOOP_DRIVER",
        "AERVOX_TURN_EXECUTION",
        "AERVOX_LOOP_COMPACTION",
        "DATABASE_URL",
        "DATABASE_AUTH_TOKEN",
        "AERVOX_CR030_STATE_PATH",
        "AERVOX_TRUST_LOCAL_DEV_HOST",
        "AERVOX_PROACTIVE_ACCESS_TOKEN",
        "AERVOX_PROACTIVE_ACCESS_TOKEN_PATH",
        "AERVOX_PROACTIVE_VAULT_URL",
        "AERVOX_PROACTIVE_VAULT_KEY_PATH",
        "AERVOX_PROACTIVE_FILE_ROOTS",
        "AERVOX_RENDERER_DEBUG_PORT",
        "AERVOX_NATIVE_DATA_DIR",
        "AERVOX_NATIVE_SUPERVISOR_MANAGED",
        "AERVOX_AUDIO_PREPROCESSOR",
        "AERVOX_LOCAL_RUNTIME_HOST",
        "AERVOX_MEMORY_VECTOR_ENGINE",
        "AERVOX_LLAMA_SERVER_PATH",
        "AERVOX_P2P_IDENTITY_PATH",
        "AERVOX_WORKER_IPC_SOCKET",
        "AERVOX_WORKER_HEALTH_PORT",
        "WORKER_ID",
        "WORKER_TICK_MS",
        "WORKER_INTERVAL_OUTBOX_MS",
        "WORKER_INTERVAL_REVIEW_MS",
        "WORKER_INTERVAL_DIARY_MS",
        "WORKER_INTERVAL_DELETION_MS",
        "WORKER_INTERVAL_COMPACTION_MS",
        "WORKER_INTERVAL_EMBEDDING_MS",
        "WORKER_INTERVAL_ATTEMPT_RECOVERY_MS",
        "WORKER_INTERVAL_INBOX_EXPIRY_MS",
        "WORKER_INTERVAL_PROACTIVE_PROFILE_MS",
        "WORKER_INTERVAL_PROACTIVE_INTELLIGENCE_MS",
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "DEEPSEEK_API_KEY",
        "DSH_LLM_BASE_URL",
        "DSH_MODEL_ID",
        "AERVOX_DSH_REPO_ROOT",
        "GPT_SOVITS_ENDPOINT",
        "GPT_SOVITS_PROTOCOL",
        "GPT_SOVITS_MODEL_PATH",
        "GPT_SOVITS_ALLOWED_ROOTS",
        "WHISPER_ENDPOINT",
        "WHISPER_API_KEY",
        "WHISPER_MODEL_ID",
        "VITE_API_URL",
        "VITE_SESSION_ID",
        "VITE_AERVOX_PLATFORM"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts"
      ]
    },
    "@aervox/worker#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "vitest.config.*", "../../vitest.shared.ts", "../../plugins/**"]
    },
    "@aervox/api#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts",
        "../../apps/desktop/src/main/turn-bridge.ts",
        "../../apps/desktop/src/main/runtime-config.ts",
        "../../plugins/**"
      ]
    },
    "@aervox/native-runtime#native:build": {"dependsOn": ["build"], "cache": false, "env": ["AERVOX_NATIVE_BUILD_TARGETS"], "inputs": ["$TURBO_DEFAULT$", "../../scripts/build-native-runtime.mjs", "../../mise.toml", "../../native/**"], "outputs": ["dist/bin/**"]},
    "@aervox/repositories#test": {"dependsOn": ["^build", "@aervox/native-runtime#native:build"]}
  }
}
