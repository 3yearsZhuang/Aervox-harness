{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AERVOX_WEB_PORT", "AERVOX_DESKTOP_PORT", "AERVOX_NATIVE_RELEASE_PUBLIC_KEY"],
  "globalDependencies": ["tsconfig.base.json", "tsconfig.base.node.json", "scripts/vendor-chunks.ts", "patches/**"],
  "globalPassThroughEnv": [
    "XDG_CONFIG_HOME",
    "XDG_DATA_HOME",
    "XDG_STATE_HOME",
    "CI",
    "PNPM_CONFIG_SCRIPT_SHELL",
    "VITEST_MAX_WORKERS"
  ],
  "tasks": {
    "@aervox/native-runtime#build": {"dependsOn": ["^build"], "outputs": ["dist/**", "!dist/bin/**"], "inputs": ["$TURBO_DEFAULT$", "../../native/protocol/**", "../../scripts/generate-native-protocol.mjs"]},
    "@aervox/native-runtime#test": {"dependsOn": ["build", "native:build"], "cache": false, "inputs": ["$TURBO_DEFAULT$", "../../native/protocol/**"]},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@aervox/live2d#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/public#test": {
      "dependsOn": ["^build"],
      "inputs": ["scripts/**", "aervox-intro/**", "aervox-mark.svg", "package.json"]
    },
    "@aervox/mobile#build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@aervox/cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../LICENSE"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts"
      ]
    },
    "@aervox/api#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "vitest.config.*",
        "../../vitest.shared.ts",
        "../../plugins/**"
      ]
    },
    "@aervox/native-runtime#native:build": {"dependsOn": ["build"], "cache": false, "env": ["AERVOX_NATIVE_BUILD_TARGETS"], "inputs": ["$TURBO_DEFAULT$", "../../scripts/build-native-runtime.mjs", "../../mise.toml", "../../native/**"], "outputs": ["dist/bin/**"]},
    "@aervox/repositories#test": {"dependsOn": ["^build", "@aervox/native-runtime#native:build"]}
  }
}
