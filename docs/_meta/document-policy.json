{
  "schemaVersion": 1,
  "policyId": "AVX-DOC-GOV-001",
  "registryPath": "docs/DOC_REGISTRY.md",
  "currentIterationPlan": {
    "path": "plan.md",
    "id": "AVX-PLAN-001",
    "type": "reference",
    "scope": "guide",
    "planningRole": "current",
    "queue": {
      "source": "docs/_meta/plan-queue.json",
      "target": "plan.md",
      "wipLimit": 3,
      "enforcement": "error",
      "note": "queue.source 是队列机器真源，plan.md §2 为派生视图（plan-render 生成、plan-check 校验）。enforcement=error 为强制期（2026-09-18 升级，此前 warning 观察期已验证：临时切换 error 后仓库 0 阻断通过、认领→移交闭环由 ITER-001 跑通一次）：H1–H6 与 S1–S4 一律阻断，仅 S5（依赖次序）保持提示，以保留可并行的前置设计与测试夹具空间。"
    }
  },
  "defaultReviewIntervalDays": 90,
  "requiredFrontMatterFields": [
    "id",
    "type",
    "scope",
    "owner",
    "doc_status",
    "version",
    "updated_at",
    "reviewed_at"
  ],
  "directories": {
    "tutorials": {
      "type": "tutorial",
      "answers": "如何从起点完成一次可验证学习路径"
    },
    "how-to": {
      "type": "how-to",
      "answers": "如何完成一个具体维护或开发任务"
    },
    "explanation": {
      "type": "explanation",
      "answers": "为什么这样设计，以及系统如何运作"
    },
    "reference": {
      "type": "reference",
      "answers": "准确的契约、状态、规则和清单是什么"
    },
    "templates": {
      "type": "template",
      "answers": "新文档的最小结构是什么"
    },
    "proposals": {
      "type": "reference",
      "answers": "未采纳或待补充证据的技术与架构方案"
    },
    "archive": {
      "type": "reference",
      "answers": "已完成或已退役的历史变更与决策记录"
    }
  },
  "documentStatus": [
    "draft",
    "review-candidate",
    "approved",
    "superseded",
    "retired"
  ],
  "decisionStatus": [
    "proposed",
    "accepted",
    "rejected",
    "deferred",
    "more-evidence-required",
    "not-applicable"
  ],
  "deliveryStatus": [
    "planned",
    "implemented",
    "verified",
    "released",
    "not-applicable"
  ],
  "sourceKinds": [
    "native",
    "T-*",
    "AST-*",
    "PET-*",
    "DSH-01",
    "PI-01",
    "Skill",
    "CR-*",
    "ADR-*"
  ],
  "derivedViews": {
    "currentMode": "manual",
    "plannedCatalog": "docs/_meta/document-catalog.json",
    "views": [
      "docs/README.md",
      "docs/DOC_REGISTRY.md",
      "docs/reference/adr/README.md"
    ]
  },
  "canonicalSources": {
    "product": [
      "docs/reference/PRD.md"
    ],
    "requirements": [
      "docs/reference/SRS.md",
      "docs/reference/REQUIREMENTS_TRACEABILITY.md"
    ],
    "architecture": [
      "docs/reference/ARCHITECTURE.md",
      "docs/reference/adr/"
    ],
    "contracts": [
      "packages/contracts/",
      "docs/reference/STREAMING_PROTOCOL.md"
    ],
    "database": [
      "packages/schema/",
      "packages/repositories/",
      "docs/reference/DATABASE.md"
    ],
    "changeDeltas": [
      "docs/reference/changes/"
    ],
    "documentGovernance": [
      "docs/reference/document-governance.md",
      "docs/_meta/document-policy.json"
    ],
    "documentLifecycle": [
      "docs/DOC_REGISTRY.md"
    ]
  },
  "reviewTriggers": {
    "product": [
      "docs/reference/PRD.md",
      "release scope, CAP, priority, or stage changes"
    ],
    "requirements": [
      "docs/reference/SRS.md",
      "docs/reference/REQUIREMENTS_TRACEABILITY.md",
      "AC, TC, DoR, or DoD status changes"
    ],
    "architecture": [
      "apps/**/src/**",
      "packages/*/package.json",
      "pnpm-workspace.yaml",
      "docs/reference/adr/**",
      "docs/reference/changes/**"
    ],
    "contracts": [
      "packages/contracts/**",
      "packages/api-client/**",
      "docs/reference/STREAMING_PROTOCOL.md"
    ],
    "database": [
      "packages/schema/**",
      "packages/repositories/**",
      "docs/reference/DATABASE.md"
    ],
    "agentLoop": [
      "packages/agent-loop/**",
      "apps/api/src/modules/conversation/**",
      "docs/reference/agent-harness-loop.md"
    ],
    "extensions": [
      "modules/**",
      "apps/api/src/modules/plugins/**",
      "apps/api/src/modules/skills/**",
      "docs/reference/capability-*.md"
    ],
    "operations": [
      "apps/worker/**",
      "deployment, backup, recovery, or observability changes"
    ]
  },
  "migration": {
    "mode": "compatibility",
    "legacyMetadataAllowed": true,
    "canonicalFormat": "yaml-front-matter",
    "strictModeEnvironment": "DOCS_GOVERNANCE_STRICT=1",
    "note": "Legacy blockquote and ADR/CR bullet metadata remain readable during migration. New documents use the canonical front matter schema."
  }
}
