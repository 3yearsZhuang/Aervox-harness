{
  "name": "@aervox/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aervox runtime configuration: typed env parsing with defaults and startup validation (converges process.env reads across api/worker).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}