{
  "name": "@aervox/repositories",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aervox/contracts": "workspace:*",
    "@aervox/native-runtime": "workspace:*",
    "@aervox/schema": "workspace:*",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.4",
    "@aervox/sync-runtime": "workspace:*",
    "@aervox/process-coordination": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
