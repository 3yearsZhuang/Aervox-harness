    "@aervox/plugin-focus-mode": "workspace:*",
    "@aervox/plugin-bot-weixin": "workspace:*",
    "@aervox/plugin-bot-onebot": "workspace:*",
    "@aervox/practice-review": "workspace:*",
    "@aervox/repositories": "workspace:*",
    "@aervox/schema": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@libsql/client": "^0.14.0",
    "@vscode/ripgrep": "1.18.0",
