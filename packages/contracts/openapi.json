{
  "openapi": "3.1.0",
  "info": {
    "title": "Aervox｜思隅 Turn Streaming API",
    "version": "0.1.0",
    "description": "对话流式协议（Turn/SSE）机器可验证契约。规则见 docs/reference/STREAMING_PROTOCOL.md（AVX-SPC-001）。"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "CreateLearningGoal": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "availableMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "topic"
        ]
      },
      "UpdateLearningGoal": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "availableMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "completed"
            ]
          }
        }
      },
      "CreateTurnRequest": {
        "type": "object",
        "properties": {
          "message": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              },
              "contentType": {
                "type": "string",
                "enum": [
                  "text",
                  "markdown"
                ]
              }
            },
            "required": [
              "content",
              "contentType"
            ]
          },
          "clientVersion": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "sourceVersion"
              ]
            }
          }
        },
        "required": [
          "message",
          "clientVersion"
        ]
      },
      "CreateTurnResponse": {
        "type": "object",
        "properties": {
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Created"
            ]
          },
          "eventsUrl": {
            "type": "string",
            "minLength": 1
          },
          "cancelUrl": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "turnId",
          "status",
          "eventsUrl",
          "cancelUrl"
        ]
      },
      "CancelTurnResponse": {
        "type": "object",
        "properties": {
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "CancelRequested",
              "Cancelled"
            ]
          }
        },
        "required": [
          "turnId",
          "status"
        ]
      },
      "TurnStreamEvent": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "eventType": {
            "type": "string",
            "enum": [
              "message",
              "delta",
              "done",
              "error",
              "redacted",
              "emote"
            ]
          },
          "payloadVersion": {
            "type": "integer"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "modelRunId": {
            "type": "string"
          },
          "data": {}
        },
        "required": [
          "eventId",
          "turnId",
          "sequence",
          "eventType",
          "payloadVersion",
          "occurredAt"
        ]
      },
      "MessageEventData": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ]
          },
          "contentType": {
            "type": "string",
            "enum": [
              "text",
              "markdown"
            ]
          },
          "isComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "messageId",
          "role",
          "contentType",
          "isComplete"
        ]
      },
      "DeltaEventData": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "isFinal": {
            "type": "boolean"
          }
        },
        "required": [
          "messageId",
          "text",
          "isFinal"
        ]
      },
      "DoneEventData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Created",
              "InputChecking",
              "Running",
              "Finalizing",
              "Completed",
              "Rejected",
              "CancelRequested",
              "Cancelled",
              "Interrupted",
              "Failed"
            ]
          },
          "messageId": {
            "type": "string"
          },
          "isComplete": {
            "type": "boolean"
          },
          "lastSequence": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "contextVersion": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "isComplete",
          "lastSequence"
        ]
      },
      "ErrorEventData": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "IDEMPOTENCY_KEY_REUSED",
              "TURN_NOT_FOUND",
              "STREAM_CURSOR_EXPIRED",
              "TURN_CANCELLED",
              "MODEL_TIMEOUT",
              "MODEL_UNAVAILABLE",
              "OUTPUT_SAFETY_BLOCKED",
              "PERMISSION_REVOKED"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "lastSequence": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "code",
          "retryable",
          "message",
          "lastSequence"
        ]
      },
      "RedactedEventData": {
        "type": "object",
        "properties": {
          "targetEventId": {
            "type": "string",
            "minLength": 1
          },
          "visibilityRevision": {
            "type": "integer"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "revoked",
              "deleted",
              "policy_changed"
            ]
          },
          "replacement": {
            "type": "string"
          }
        },
        "required": [
          "targetEventId",
          "visibilityRevision",
          "reasonCode"
        ]
      },
      "PetCommand": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "speak",
              "emote",
              "gesture",
              "move",
              "react"
            ]
          },
          "emote": {
            "type": "string",
            "enum": [
              "idle",
              "cheer",
              "think",
              "worry",
              "happy",
              "sad",
              "surprise"
            ]
          },
          "gesture": {
            "type": "string",
            "enum": [
              "wave",
              "nod",
              "shake",
              "stretch",
              "yawn"
            ]
          },
          "text": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "type"
        ]
      },
      "EmoteEventData": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "speak",
              "emote",
              "gesture",
              "move",
              "react"
            ]
          },
          "emote": {
            "type": "string",
            "enum": [
              "idle",
              "cheer",
              "think",
              "worry",
              "happy",
              "sad",
              "surprise"
            ]
          },
          "gesture": {
            "type": "string",
            "enum": [
              "wave",
              "nod",
              "shake",
              "stretch",
              "yawn"
            ]
          },
          "text": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "type"
        ]
      },
      "StreamErrorCode": {
        "type": "string",
        "enum": [
          "IDEMPOTENCY_KEY_REUSED",
          "TURN_NOT_FOUND",
          "STREAM_CURSOR_EXPIRED",
          "TURN_CANCELLED",
          "MODEL_TIMEOUT",
          "MODEL_UNAVAILABLE",
          "OUTPUT_SAFETY_BLOCKED",
          "PERMISSION_REVOKED"
        ]
      },
      "ToolMetadata": {
        "type": "object",
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "memory",
              "search",
              "learning",
              "diary",
              "system",
              "external"
            ]
          },
          "safetyLevel": {
            "type": "string",
            "enum": [
              "read_only",
              "write_with_approval",
              "privileged"
            ],
            "default": "write_with_approval"
          },
          "requiredPermissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "inputSchema": {},
          "builtin": {
            "type": "boolean",
            "default": false
          },
          "pluginId": {
            "type": "string"
          }
        },
        "required": [
          "toolId",
          "name",
          "description",
          "category"
        ]
      },
      "ToolRegistryEntry": {
        "type": "object",
        "properties": {
          "toolId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "memory",
              "search",
              "learning",
              "diary",
              "system",
              "external"
            ]
          },
          "safetyLevel": {
            "type": "string",
            "enum": [
              "read_only",
              "write_with_approval",
              "privileged"
            ],
            "default": "write_with_approval"
          },
          "requiredPermissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "inputSchema": {},
          "builtin": {
            "type": "boolean",
            "default": false
          },
          "pluginId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "gatingConditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "equals",
                    "in",
                    "truthy",
                    "custom"
                  ]
                },
                "value": {},
                "evaluatorId": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "operator"
              ]
            },
            "default": []
          },
          "priority": {
            "type": "integer",
            "default": 0
          }
        },
        "required": [
          "toolId",
          "name",
          "description",
          "category"
        ]
      },
      "ToolRegistryExport": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "toolId": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "memory",
                    "search",
                    "learning",
                    "diary",
                    "system",
                    "external"
                  ]
                },
                "safetyLevel": {
                  "type": "string",
                  "enum": [
                    "read_only",
                    "write_with_approval",
                    "privileged"
                  ],
                  "default": "write_with_approval"
                },
                "requiredPermissions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": []
                },
                "inputSchema": {},
                "builtin": {
                  "type": "boolean",
                  "default": false
                },
                "pluginId": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "gatingConditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "equals",
                          "in",
                          "truthy",
                          "custom"
                        ]
                      },
                      "value": {},
                      "evaluatorId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "operator"
                    ]
                  },
                  "default": []
                },
                "priority": {
                  "type": "integer",
                  "default": 0
                }
              },
              "required": [
                "toolId",
                "name",
                "description",
                "category"
              ]
            }
          },
          "disabledToolIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "exportVersion": {
            "type": "integer"
          }
        },
        "required": [
          "tools",
          "exportVersion"
        ]
      },
      "MemoryStoreToolInput": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "user_said",
              "ai_inferred"
            ],
            "default": "ai_inferred"
          },
          "category": {
            "type": "string",
            "enum": [
              "identity",
              "preference",
              "habit",
              "schedule",
              "relationship",
              "event",
              "other"
            ],
            "default": "other"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "sourceTurnId": {
            "type": "string"
          },
          "asCandidate": {
            "type": "boolean"
          }
        },
        "required": [
          "content"
        ]
      },
      "MemoryStoreToolOutput": {
        "type": "object",
        "properties": {
          "memoryId": {
            "type": "string",
            "minLength": 1
          },
          "isCandidate": {
            "type": "boolean"
          },
          "deduplicatedMemoryId": {
            "type": "string"
          },
          "embeddingStatus": {
            "type": "string",
            "enum": [
              "indexed",
              "skipped",
              "failed"
            ]
          }
        },
        "required": [
          "memoryId",
          "isCandidate"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/sessions/{sessionId}/turns": {
      "post": {
        "summary": "创建 Turn（幂等）",
        "tags": [
          "Turn"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "sessionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "Idempotency-Key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "object",
                    "properties": {
                      "content": {
                        "type": "string",
                        "minLength": 1
                      },
                      "contentType": {
                        "type": "string",
                        "enum": [
                          "text",
                          "markdown"
                        ]
                      }
                    },
                    "required": [
                      "content",
                      "contentType"
                    ]
                  },
                  "clientVersion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sourceVersion": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "sourceId",
                        "sourceVersion"
                      ]
                    }
                  }
                },
                "required": [
                  "message",
                  "clientVersion"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "turnId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "Created"
                      ]
                    },
                    "eventsUrl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cancelUrl": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "turnId",
                    "status",
                    "eventsUrl",
                    "cancelUrl"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "IDEMPOTENCY_KEY_REUSED",
                        "TURN_NOT_FOUND",
                        "STREAM_CURSOR_EXPIRED",
                        "TURN_CANCELLED",
                        "MODEL_TIMEOUT",
                        "MODEL_UNAVAILABLE",
                        "OUTPUT_SAFETY_BLOCKED",
                        "PERMISSION_REVOKED"
                      ]
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lastSequence": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "code",
                    "retryable",
                    "message",
                    "lastSequence"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "IDEMPOTENCY_KEY_REUSED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "IDEMPOTENCY_KEY_REUSED",
                        "TURN_NOT_FOUND",
                        "STREAM_CURSOR_EXPIRED",
                        "TURN_CANCELLED",
                        "MODEL_TIMEOUT",
                        "MODEL_UNAVAILABLE",
                        "OUTPUT_SAFETY_BLOCKED",
                        "PERMISSION_REVOKED"
                      ]
                    },
                    "retryable": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lastSequence": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "code",
                    "retryable",
                    "message",
                    "lastSequence"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/turns/{turnId}/events": {
      "get": {
        "summary": "读取 Turn SSE 事件流",
        "tags": [
          "Turn"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "turnId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "eventId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "turnId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sequence": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "eventType": {
                      "type": "string",
                      "enum": [
                        "message",
                        "delta",
                        "done",
                        "error",
                        "redacted",
                        "emote"
                      ]
                    },
                    "payloadVersion": {
                      "type": "integer"
                    },
                    "occurredAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "modelRunId": {
                      "type": "string"
                    },
                    "data": {}
                  },
                  "required": [
                    "eventId",
                    "turnId",
                    "sequence",
                    "eventType",
                    "payloadVersion",
                    "occurredAt"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "TURN_NOT_FOUND"
          },
          "410": {
            "description": "STREAM_CURSOR_EXPIRED"
          }
        }
      }
    },
    "/v1/turns/{turnId}/cancel": {
      "post": {
        "summary": "取消 Turn",
        "tags": [
          "Turn"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "turnId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "turnId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "CancelRequested",
                        "Cancelled"
                      ]
                    }
                  },
                  "required": [
                    "turnId",
                    "status"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "TURN_NOT_FOUND"
          }
        }
      }
    },
