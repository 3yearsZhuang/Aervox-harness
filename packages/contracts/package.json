{
  "name": "@aervox/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proactive": {
      "types": "./dist/proactive.d.ts",
      "default": "./dist/proactive.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm generate:openapi",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:openapi": "node scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "openapi3-ts": "4.6.1",
    "zod": "4.4.3"
  }
}
