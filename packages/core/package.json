{
  "name": "@aervox/core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Aervox standalone agent kernel: executor, ControlContext, approval SPI, tool sandbox (in-memory), CLI approval. Zero runtime dependencies (ADR-021).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@aervox/contracts": "workspace:*",
    "@types/node": "^22.10.0"
  }
}
