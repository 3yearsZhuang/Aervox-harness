# Legacy local-only Live2D test assets retained outside the committed fixed model.
apps/desktop/src/renderer/public/live2d-test/
apps/web/public/live2d-test/

# 构建期拷贝的 Live2D 桌宠模型产物（真源：packages/live2d/mizuki，W-15 收敛）
apps/desktop/src/renderer/public/live2d/
apps/web/public/live2d/

# 构建期拷贝的 Live2D Cubism Core 制品（真源：packages/live2d/cubism，按摘要校验）
# 运行时从本地加载，不再引用 cubism.live2d.com。
apps/desktop/src/renderer/public/vendor/
apps/web/public/vendor/

# Playwright E2E artifacts
test-results/
playwright-report/

# 本地分析产物与架构可视化产物
artifacts/

# 本地杂项防误提交（曾出现于工作区并被误 add 过的类型）
*.psd
package-lock.json
app.js
*.inspect.ndjson

# IDE / 协作工具本地工作目录（不应入库）
.workbuddy/
.zcode/
.commandcode/

# tsc 产物误入 src/ 的提交兜底（根因护栏见 tsconfig.base.json 的 "include": []）
# 编译产物与同名 .ts 并存时，vitest/tsx 会优先解析到过期的 .js ——
# 表现为「行为与源码不符」且不报任何错。此处只做提交层面的兜底，不替代根因护栏。
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.d.ts
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts.map

# 例外：手写类型声明与 vendored 运行库（新增此类文件仍需显式 git add -f）
!**/env.d.ts
!**/sherpa-onnx-node.d.ts
!**/*.min.js

# Generated shared assets; source: packages/public (build restores consumer copies).
apps/desktop/src/renderer/public/aervox-intro/
apps/desktop/src/renderer/public/aervox-mark.svg
apps/web/public/aervox-mark.svg

# 运行时日志目录（内部 *.log 已被上文忽略，目录本身此前未被忽略）
.logs/

# Cubism Core 本地副本：页面实际经 CDN 加载，移动端经 apps/mobile 的固定 SHA3 恢复流程取得。
# 放回 public/vendor 只是离线调试的临时动作，属生成物而非真源（真源见
# apps/mobile/scripts/prepare-native-assets.mjs 的 coreArtifact 固定字节）。
apps/desktop/src/renderer/public/vendor/
apps/web/public/vendor/
