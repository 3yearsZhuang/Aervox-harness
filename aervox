  printf "\n${CYAN}╭───────────────────────────────────────────────────────────────╮${NC}\n"
  printf "${CYAN}│${NC}  ${GREEN}${BOLD}Aervox｜思隅  开发环境启动${NC} (Dev Environment)                ${CYAN}│${NC}\n"
  printf "${CYAN}│${NC}  模式: ${YELLOW}%-10s${NC}                                            ${CYAN}│${NC}\n" "$target"
  printf "${CYAN}│${NC}                                                               ${CYAN}│${NC}\n"
  case "$target" in
    full)
