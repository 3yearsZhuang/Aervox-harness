# 启动只接受锁定安装；重新解析依赖必须显式运行 setup。
ensure_deps() {
  if [ "${_AERVOX_DEPS_ENSURED:-0}" -eq 1 ]; then
    return 0
  fi
  ensure_mise
  info "按锁文件检查依赖…"
  run pnpm install --frozen-lockfile --prefer-offline
  _AERVOX_DEPS_ENSURED=1
  ok "依赖已就绪"
}

cmd_setup() {
  ensure_mise
  info "mise install(幂等)…"
  mise install
  info "重新解析依赖…"
  run pnpm install --no-frozen-lockfile
  ok "setup 完成"
}

cmd_dev() {
  local clean_ports=0
  local target="full"
  local extra_flags=( "--output-logs=new-only" )

  while [ $# -gt 0 ]; do
    case "$1" in
      --clean-ports|-k)
        clean_ports=1
        shift
        ;;
      --tui)
        extra_flags+=( "--ui" "tui" )
        shift
        ;;
      full|web|desktop|cli|worker|api)
        target="$1"
        shift
        ;;
      *)
        if [[ "$1" == -* ]]; then
          fail "未知 dev 选项: $1（支持: --clean-ports / -k, --tui）"
        else
          fail "未知 dev 目标: $1（可用: full | web | desktop | cli | worker | api）"
        fi
        ;;
    esac
  done

  # Repository connections resolve relative paths against their repository root.
  # Keep URI authorities, percent escapes and :memory: identities intact.
  export DATABASE_URL="${DATABASE_URL:-file:$PWD/data/aervox.db}"

  local selected_port
  while IFS= read -r selected_port; do
    [ -n "$selected_port" ] || continue
    validate_dev_port "$selected_port"
  done < <(dev_ports "$target")

  if [ $clean_ports -eq 1 ]; then
    cleanup_dev_ports "$target"
  fi

  if [ "$target" != "cli" ]; then
    check_dev_ports "$target"
  fi

  ensure_deps

  # CAP-033：dev 下 API 与桌面端必须解析同一个主动画像 Token 文件。
  # API 默认写 <仓库>/data/proactive-access.token，桌面端默认读用户应用数据目录下的同名文件；
  # 两份 Token 不一致会让桌面端所有 /v1/proactive/* 请求 401（界面显示“本地主动画像 Vault 尚未就绪”）。
  # 显式设置 AERVOX_PROACTIVE_ACCESS_TOKEN 时仍然以该 Token 为准，本默认值不覆盖它。
  export AERVOX_PROACTIVE_ACCESS_TOKEN_PATH="${AERVOX_PROACTIVE_ACCESS_TOKEN_PATH:-$PWD/data/proactive-access.token}"
  mkdir -p "$(dirname "$AERVOX_PROACTIVE_ACCESS_TOKEN_PATH")"

  case "$target" in
    full|desktop)
      # 未签名 dev Electron 默认被 Host 判为不受信 → 主动智能整体挂起。
      # 开发脚本显式开启本地信任（正是该开关的预期用法）；显式设为 0 可关闭。
      export AERVOX_TRUST_LOCAL_DEV_HOST="${AERVOX_TRUST_LOCAL_DEV_HOST:-1}"
      ;;
  esac

  show_dev_banner "$target"

  case "$target" in
    full)
      run pnpm exec turbo run dev "${extra_flags[@]}" --filter=@aervox/api --filter=@aervox/web --filter=@aervox/desktop --filter=@aervox/worker
      ;;
    web)
      run pnpm exec turbo run dev "${extra_flags[@]}" --filter=@aervox/api --filter=@aervox/web
      ;;
    desktop)
      run pnpm exec turbo run dev "${extra_flags[@]}" --filter=@aervox/api --filter=@aervox/desktop
      ;;
    cli)
      cmd_dev_cli
      ;;
    worker)
      run pnpm exec turbo run dev "${extra_flags[@]}" --filter=@aervox/worker
      ;;
    api)
      run pnpm exec turbo run dev "${extra_flags[@]}" --filter=@aervox/api
      ;;
  esac
}

cmd_cli() {
  ensure_deps
  if [ ! -f apps/cli/dist/index.js ] || [ -n "$(find apps/cli/src -newer apps/cli/dist/index.js 2>/dev/null)" ]; then
    info "构建 CLI 产物…"
    run pnpm --filter @aervox/cli build
  fi
  run node apps/cli/dist/index.js "${@:-chat}"
}

cmd_dev_cli() (
  # Keep traps and their local process ownership inside this CLI session.
  ensure_deps
  info "检查并构建 CLI 产物…"
  run pnpm --filter @aervox/cli build
  local api_url="${SIYU_API_URL:-http://127.0.0.1:${PORT:-3000}}"
  api_url="$(run node apps/cli/dist/validate-api-url.js "$api_url")"
  export SIYU_API_URL="$api_url"
  local api_pid=""

  cleanup_dev_cli_api() {
    if [ -n "$api_pid" ]; then
      info "正在停止由本会话启动的后台思隅 API 服务…"
      kill -TERM -- "-$api_pid" 2>/dev/null || true
      wait "$api_pid" 2>/dev/null || true
    fi
  }
  trap cleanup_dev_cli_api EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  probe_dev_cli_api() {
    local probe_args=(--fail --silent --connect-timeout 1 --max-time 2 --output /dev/null)
    if [ -n "${SIYU_API_TOKEN:-}" ]; then
      if [[ "$SIYU_API_TOKEN" == *$'\r'* || "$SIYU_API_TOKEN" == *$'\n'* ]]; then
        fail "SIYU_API_TOKEN 不能包含换行符"
      fi
      printf 'Authorization: Bearer %s\n' "$SIYU_API_TOKEN" | curl "${probe_args[@]}" --header @- "$api_url/v1/sessions?limit=1"
    else
      curl "${probe_args[@]}" "$api_url/v1/sessions?limit=1"
    fi
  }

  if probe_dev_cli_api; then
    ok "思隅 API 服务已在运行: $api_url"
  else
    case "$api_url" in
      "http://127.0.0.1:${PORT:-3000}"|"http://localhost:${PORT:-3000}"|"http://[::1]:${PORT:-3000}") ;;
      *) fail "指定 API 地址尚未就绪: $api_url；请先启动该服务" ;;
    esac
    check_dev_ports api
    info "正在后台启动思隅 API 服务(${PORT:-3000})…"
    mkdir -p .logs
    # Give only this newly started service its own process group so cleanup
    # reaches Turbo and its descendants without touching a reused API.
    set -m
    run pnpm exec turbo run dev --filter=@aervox/api > .logs/api-dev.log 2>&1 &
    api_pid=$!
    set +m
    local deadline=$((SECONDS + 20))
    local ready=0
    while (( SECONDS < deadline )); do
      if ! kill -0 "$api_pid" 2>/dev/null; then
        fail "API 启动失败，请查看 .logs/api-dev.log"
      fi
      if probe_dev_cli_api; then
        ready=1
        break
      fi
      sleep 0.5
    done
    if [ $ready -eq 1 ]; then
      ok "思隅 API 服务已就绪: $api_url"
    else
      fail "等待 API 就绪超时，请查看 .logs/api-dev.log"
    fi
  fi

  info "启动思隅终端客户端 (siyu chat)…"
  run node apps/cli/dist/index.js chat
)

cmd_mobile() {
  ensure_deps
  info "构建 Web 产物…"
  run pnpm --filter @aervox/web build
  info "Capacitor 同步(web)…"
  (cd apps/mobile && run npx cap sync web)
  ok "移动壳已同步(webDir: apps/web/dist)"
}

cmd_package() {
  ensure_deps
  info "打包桌面端（构建 + electron-builder，产物在 apps/desktop/release/）…"
  run pnpm dist:desktop
  ok "打包完成：apps/desktop/release/"
}

cmd_clean() {
  info "清理构建产物(保留 node_modules)…"
  run node scripts/clean-generated.mjs "$@"
  if [ "${1:-}" = "--dry-run" ]; then
    ok "已预览清理范围，未删除文件"
  else
    ok "已清理 dist / out / .turbo"
  fi
}

cmd_test() {
  ensure_mise
  local target="${1:-affected}"
  case "$target" in
    affected)
      info "运行智能增量测试 (基于 git 变更包及其下游)…"
      run pnpm test:affected
      ;;
    unit|fast)
      info "运行选定包测试 (核心逻辑、领域契约、前端组件与插件)…"
      run pnpm test:unit
      ;;
    guards)
      info "运行架构与门禁脚本守护测试 (scripts/*.test.mjs)…"
      run pnpm test:guards
      ;;
    all|full)
      info "运行全量测试 (受控 2 并发)…"
      run pnpm test
      ;;
    *)
      run node scripts/test-package.mjs "$target"
      ;;
  esac
  ok "测试完成"
}

cmd_ci() {
  ensure_mise
  local mode="${1:-affected}"
  case "$mode" in
    all|full)
      info "执行全量终审门禁 (代码全量 + 文档全量)…"
      mise tasks run ci-code
      mise tasks run ci-docs
      ok "全量门禁全部通过"
      ;;
    fast|affected|*)
      info "执行极速增量门禁 (代码增量 + 文档增量)…"
      ensure_deps
      mise tasks run ci-fast
      ok "增量门禁全部通过"
      ;;
  esac
}

# ── 分发 ────────────────────────────────────────────────
CMD="${1:-help}"; shift || true
case "$CMD" in
  help|-h|--help)          help ;;
  setup)                   cmd_setup ;;
  dev)                     cmd_dev "$@" ;;
  cli)                     cmd_cli "$@" ;;
  mobile)                  cmd_mobile ;;
  package)                 cmd_package ;;
  clean)                   cmd_clean "$@" ;;
  test)                    cmd_test "${1:-affected}" ;;
  ci)                      cmd_ci "${1:-affected}" ;;
  *)                       fail "未知命令: ${CMD}（运行 aervox help 查看用法）" ;;
esac
