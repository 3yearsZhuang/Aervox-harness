#!/usr/bin/env bash
#
# Aervox 统一命令入口
# 一条命令 + 变体覆盖：前置依赖、各端启动、构建移动壳、清理产物、本地门禁。
#
set -euo pipefail

cd "$(dirname "$0")" # 始终以仓库根为工作目录

source scripts/project-env.sh

GREEN='\033[0;32m'; YELLOW='\033[0;33m'; CYAN='\033[0;36m'; RED='\033[0;31m'; BOLD='\033[1m'; NC='\033[0m'
info() { printf "${CYAN}[aervox]${NC} %s\n" "$*"; }
ok()   { printf "${GREEN}[aervox]${NC} %s\n" "$*"; }
warn() { printf "${YELLOW}[aervox]${NC} %s\n" "$*"; }
fail() { printf "${RED}[aervox]${NC} %s\n" "$*" >&2; exit 1; }

HELP="$(
  cat <<'EOF'
用法:  aervox <命令> [目标/参数...]

命令:
  setup                        前置安装: mise install(幂等) + 重新解析依赖
  dev [目标] [选项]            启动开发服务:
                                 full      = API + Web + Desktop + Worker (默认)
                                 web       = API + Web(5173)
                                 desktop   = API + Desktop(Electron)
                                 cli       = API + 终端交互客户端(siyu chat)
                                 worker    = 仅 Worker(后台任务)
                                 api       = 仅 API(3000)
                               选项:
                                 --clean-ports, -k  启动前停止所选目标端口的监听进程
                                 --tui              启用 Turborepo 交互式分屏面板
  cli [参数...]                启动思隅终端客户端(siyu); 默认启动连续对话(chat)
  mobile                       构建 Web 产物并同步 Capacitor 壳(cap sync web)
  package                      打包桌面端安装包(electron-builder, 产物 apps/desktop/release/)
  clean [--dry-run]            清理声明的构建产物和缓存；可预览路径
  test [affected|unit|guards|all|<pkg>]
                               运行测试套件:
                                 affected  = 智能增量测试(默认, 仅变更包及其下游)
                                 unit      = 选定包测试(核心逻辑、领域契约、前端组件与插件)
                                 guards    = 架构与门禁脚本守护测试
                                 all       = 全量受控 2 并发测试
                                 <pkg>     = 按真实包名、目录短名或 pnpm 过滤器测试
  ci [affected|all]            运行本地门禁:
                                 affected  = 极速增量门禁(默认, 仅检验代码变更及下游 + 变更文档, 20秒级)
                                 all       = 全量终审门禁(全量代码 + 全量文档)
  help, -h, --help             显示本帮助

依赖策略: 启动前按 frozen-lockfile 安装；失败保留原错误并退出。
          需要重新解析依赖时显式运行 aervox setup。

环境变量(各端):
  API        PORT                监听端口 (默认 3000)
  Desktop    AERVOX_API_URL      API 地址; AERVOX_SESSION_ID 现有会话 ID
             AERVOX_TRUST_LOCAL_DEV_HOST
                                 dev desktop/full 默认置 1(信任本地未签名 Host,
                                 主动智能可用); 显式设 0 恢复挂起
  Web        VITE_API_URL        API 地址 (默认 http://127.0.0.1:3000)
             VITE_SESSION_ID     会话 ID (默认 web_default)
EOF
)"

help() { printf '%s\n' "$HELP"; }

# ── 工具链 ──────────────────────────────────────────────
ensure_mise() {
  if ! command -v mise >/dev/null 2>&1; then
    fail "未检测到 mise。请先安装: brew install mise 后重试(项目锁定 Node 24 / pnpm 11)。"
  fi
}

run() { # 通过 mise exec 激活项目工具链(Node 24 / pnpm 11)后执行
  ensure_mise
  mise exec -- "$@"
}

# ── 端口管理与预检 ─────────────────────────────────────────
validate_dev_port() {
  local port="$1"
  if ! [[ "$port" =~ ^[0-9]{1,5}$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
    fail "开发端口必须是 1～65535 的十进制整数: $port"
  fi
}

port_pids() {
  local port="$1"
  validate_dev_port "$port"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
  fi
}

dev_ports() {
  case "$1" in
    full) printf '%s\n' "${PORT:-3000}" "${AERVOX_WEB_PORT:-5173}" "${AERVOX_DESKTOP_PORT:-5174}" ;;
    web) printf '%s\n' "${PORT:-3000}" "${AERVOX_WEB_PORT:-5173}" ;;
    desktop) printf '%s\n' "${PORT:-3000}" "${AERVOX_DESKTOP_PORT:-5174}" ;;
    api|cli) printf '%s\n' "${PORT:-3000}" ;;
  esac
}

cleanup_dev_ports() {
  local port pid pids=""
  while IFS= read -r port; do
    [ -n "$port" ] || continue
    pids="$(printf '%s\n%s' "$pids" "$(port_pids "$port")")"
  done < <(dev_ports "$1")
  local clean_list
  clean_list="$(printf '%s\n' "$pids" | sort -u | sed '/^[[:space:]]*$/d')"
  if [ -n "$clean_list" ]; then
    info "正在停止所选开发端口的监听进程 (PID: $(printf '%s ' $clean_list))…"
    while IFS= read -r pid; do
      kill -TERM "$pid" 2>/dev/null || true
    done <<< "$clean_list"
    sleep 0.5
    while IFS= read -r port; do
      [ -n "$port" ] || continue
      if [ -n "$(port_pids "$port")" ]; then
        fail "端口 $port 的监听进程尚未退出，请检查后重试"
      fi
    done < <(dev_ports "$1")
    ok "所选开发端口已释放"
  else
    ok "端口检查正常，未发现残留占用"
  fi
}

check_dev_ports() {
  local target="$1"
  local api_port="${PORT:-3000}"
  local web_port="${AERVOX_WEB_PORT:-5173}"

  case "$target" in
    full|web|desktop|api)
      local api_occupants
      api_occupants="$(port_pids "$api_port")"
      if [ -n "$api_occupants" ]; then
        local pids_str
        pids_str="$(printf '%s ' $api_occupants)"
        printf "\n${RED}─────────────────────────────────────────────────────────────${NC}\n" >&2
        printf "${RED}[aervox] ❌ 端口冲突: API 端口 ${api_port} 已被占用 (PID: %s)${NC}\n" "$pids_str" >&2
        printf "${YELLOW}[aervox] 提示: 存在尚未退出的旧服务，直接启动会导致 API 启动崩溃。${NC}\n" >&2
        printf "         可使用以下命令一键释放端口并重新启动:\n" >&2
        printf "           ${CYAN}./aervox dev --clean-ports${NC}  (或 ${CYAN}-k${NC})\n" >&2
        printf "         或手动清理该进程:\n" >&2
        printf "           ${CYAN}kill -TERM %s${NC}\n" "$pids_str" >&2
        printf "${RED}─────────────────────────────────────────────────────────────${NC}\n\n" >&2
        exit 1
      fi
      ;;
  esac

  case "$target" in
    full|web)
      local web_occupants
      web_occupants="$(port_pids "$web_port")"
      if [ -n "$web_occupants" ]; then
        warn "端口 ${web_port} 当前已被占用 (PID: $(printf '%s ' $web_occupants))，Web 前端将自动尝试后移端口。"
      fi
      ;;
  esac
}

