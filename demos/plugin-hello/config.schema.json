{
  "apiVersion": "aervox.dev/v1",
  "kind": "PluginConfigSchema",
  "schemaVersion": 1,
  "fields": [
    {
      "key": "greeting",
      "type": "string",
      "label": "问候语",
      "description": "页面顶部展示的问候语",
      "default": "你好，我是思隅的学习伙伴"
    },
    {
      "key": "enabled",
      "type": "boolean",
      "label": "启用演示",
      "default": true
    },
    {
      "key": "apiKey",
      "type": "secret",
      "label": "API 密钥",
      "description": "示例密钥，只显示是否已配置"
    }
  ]
}
