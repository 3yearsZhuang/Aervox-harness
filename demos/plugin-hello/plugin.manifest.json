{
  "apiVersion": "aervox.dev/v1",
  "kind": "PluginManifest",
  "metadata": {
    "id": "hello-aervox",
    "displayName": "Hello Aervox",
    "publisher": "aervox-labs",
    "version": "1.0.0",
    "description": "演示 Aervox 插件 Config 与 Page 能力的示例插件",
    "license": "MIT"
  },
  "spec": {
    "config": {
      "schemaVersion": 1,
      "entry": "config.schema.json"
    },
    "pages": [
      {
        "id": "dashboard",
        "title": "Hello 面板",
        "description": "读取/修改插件配置并调用宿主通知",
        "entry": "pages/dashboard/index.html",
        "capabilities": ["config.read", "config.write", "host.notify", "host.close"]
      }
    ]
  }
}
