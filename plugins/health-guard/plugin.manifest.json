{
  "apiVersion": "aervox.dev/v1",
  "kind": "PluginManifest",
  "metadata": {
    "id": "health-guard",
    "displayName": "久坐与健康护航助手",
    "publisher": "aervox-official",
    "version": "1.0.0",
    "description": "CR-032 首个出厂主动智能插件：基于系统空闲状态感知久坐，在合适的时机由桌宠主动送上温和的健康关怀。",
    "license": "AGPL-3.0-or-later"
  },
  "spec": {
    "proactive": {
      "sensors": [
        {
          "sourceId": "system.idle_state",
          "description": "读取键鼠空闲时长以评估工作专注度与在座状态（仅元数据，不含窗口内容）"
        }
      ],
      "triggers": [
        {
          "ruleId": "sedentary_alert",
          "name": "连续久坐健康提醒",
          "triggerType": "system_state",
          "condition": {
            "continuousActiveMinutesMin": 50,
            "idleMinutesMax": 5
          },
          "cooldownSeconds": 1800,
          "quietHoursPolicy": "respect_global",
          "petPresentation": {
            "animation": "stretch_body",
            "bubblePreset": "gentle_care"
          }
        }
      ]
    }
  }
}
