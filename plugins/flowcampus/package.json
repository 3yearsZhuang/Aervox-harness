{
  "name": "@aervox/plugin-flowcampus",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "只争朝夕 · 校园规划：本地日程、出发建议与出发前任务",
  "exports": {
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aervox/api-client": "workspace:*",
    "@aervox/contracts": "workspace:*",
    "@aervox/core": "workspace:*",
    "@aervox/host-plugin-api": "workspace:*",
    "@aervox/ui": "workspace:*",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "lucide-vue-next": "^0.468.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.43",
    "vue-tsc": "^2.2.12"
  }
}
