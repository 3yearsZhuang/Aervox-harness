# ==============================================================================
# Aervox｜思隅 — 统一环境变量配置基准模板 (.env.example)
#
# 配置加载优先级（见 mise.toml §env 与 packages/config）：
# 进程环境变量 > .env（mise env_file / aervox 脚本加载）> mise.toml [env] > 代码内置默认值
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 服务与网络 (Server & Network)
# ------------------------------------------------------------------------------
# API 服务监听端口（默认 3000）
PORT=3000
# API 服务监听地址（默认 127.0.0.1）
AERVOX_API_HOST=127.0.0.1
# Web 前端开发服务器端口（默认 5173）
AERVOX_WEB_PORT=5173
# 桌面端调试服务端口（默认 5174）
AERVOX_DESKTOP_PORT=5174
# 桌面端连接 API 的基础地址（默认 http://127.0.0.1:3000）
AERVOX_API_URL=http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. 鉴权与安全访问 (Authentication & Security)
# ------------------------------------------------------------------------------
# 认证模式：open（本地免认证） | token（强制 Bearer Token 鉴权，生产环境强制要求）
AERVOX_AUTH_MODE=open
# 访问令牌（当 AERVOX_AUTH_MODE=token 时生效，客户端请求头 Bearer 鉴权）
# AERVOX_AUTH_TOKEN=your_secure_bearer_token_here
# 高危权限特权操作管理员白名单（逗号分隔的 userId）
# AERVOX_ADMIN_IDS=usr_admin_1,usr_admin_2

# ------------------------------------------------------------------------------
# 3. 可观测性与结构化日志 (Observability & Logging - AVX-HAR-001 §16.3 / OPS-REL-001)
# ------------------------------------------------------------------------------
# 日志级别：debug | info | warn | error（默认 info）
AERVOX_LOG_LEVEL=info
# 日志格式：json（生产推荐，单行结构化 NDJSON） | pretty（开发推荐，高可读性格式）
# 缺省时 NODE_ENV=production 为 json，开发为 pretty
AERVOX_LOG_FORMAT=pretty

# ------------------------------------------------------------------------------
# 4. Agent Loop 与调度驱动 (Agent Loop & Runtime)
# ------------------------------------------------------------------------------
# Agent 模型 Provider：llm（真实大模型调用） | replay（录制重放） | scripted（脚本模拟）
AERVOX_LOOP_PROVIDER=llm
# Loop 驱动引擎：native（进程内轻量循环） | dsh（DeepSeek Harness 进程外适配器）
AERVOX_LOOP_DRIVER=native
# Turn 回合执行模式：background（异步后台执行，SSE 实时观察） | inline（同步阻塞等待）
AERVOX_TURN_EXECUTION=background
# 上下文滑动压缩策略：rule（规则截断压缩） | off（关闭压缩）
AERVOX_LOOP_COMPACTION=off

# ------------------------------------------------------------------------------
# 5. 存储与数据库 (Storage & Database - CR-030)
# ------------------------------------------------------------------------------
# SQLite / LibSQL 本地数据库连接 URL（默认 file:aervox.db）
DATABASE_URL=file:aervox.db
# 远程 LibSQL / Turso 鉴权 Token（纯本地 SQLite 时留空）
# DATABASE_AUTH_TOKEN=
# CAP-033 主动画像独立本地安全 Vault 连接（缺省存放在用户应用数据目录）
# AERVOX_PROACTIVE_VAULT_URL=file:data/proactive-vault.db
# CR-030 迁移状态清单文件路径（缺省 data/aervox.cr030.migration.json）
# AERVOX_CR030_STATE_PATH=data/aervox.cr030.migration.json

# ------------------------------------------------------------------------------
# 6. 后台 Worker 引擎 (Background Worker - ADR-004 / ADR-011)
# ------------------------------------------------------------------------------
# Worker 实例唯一标识（缺省自动生成 worker_<timestamp>）
# WORKER_ID=worker_local_1
# 默认任务检查轮询节拍（毫秒，默认 5000）
WORKER_TICK_MS=5000
# 单任务独立频率覆盖（毫秒，如未配置则继承 WORKER_TICK_MS）
# WORKER_INTERVAL_OUTBOX_MS=3000
# WORKER_INTERVAL_REVIEW_MS=10000
# WORKER_INTERVAL_DIARY_MS=60000
# WORKER_INTERVAL_DELETION_MS=30000
# WORKER_INTERVAL_COMPACTION_MS=60000
# WORKER_INTERVAL_EMBEDDING_MS=30000
# WORKER_INTERVAL_ATTEMPT_RECOVERY_MS=5000
# WORKER_INTERVAL_INBOX_EXPIRY_MS=10000
# WORKER_INTERVAL_PROACTIVE_PROFILE_MS=30000
# WORKER_INTERVAL_PROACTIVE_INTELLIGENCE_MS=60000

# ------------------------------------------------------------------------------
# 7. 模型服务与外部 Provider (LLM & DSH Providers)
# ------------------------------------------------------------------------------
# OpenAI 兼容 API Key
# OPENAI_API_KEY=sk-...
# OpenAI 兼容 API 基础地址（如本地 Ollama / vLLM / 商业中继）
# OPENAI_BASE_URL=https://api.openai.com/v1
# DeepSeek 官方 API Key（DSH 驱动使用）
# DEEPSEEK_API_KEY=sk-...
# DSH 自定义 OpenAI 兼容端点（如本地部署的模型网关）
# DSH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DSH 模型标识（默认 deepseek-chat）
# DSH_MODEL_ID=deepseek-chat
# DSH 子模块本地源码路径（用于准入探测校验）
# AERVOX_DSH_REPO_ROOT=reference/deepseek-harness

# ------------------------------------------------------------------------------
# 8. 语音合成与识别 (Voice: TTS & ASR - CAP-015 / CR-028)
# ------------------------------------------------------------------------------
# GPT-SoVITS 语音服务端点
# GPT_SOVITS_ENDPOINT=http://127.0.0.1:9880
# GPT_SOVITS 通信协议：http | websocket
GPT_SOVITS_PROTOCOL=http
# GPT-SoVITS 本地模型路径与允许访问目录（冒号分隔）
# GPT_SOVITS_MODEL_PATH=
# GPT_SOVITS_ALLOWED_ROOTS=
# Whisper 语音识别服务端点与密钥
# WHISPER_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=
# WHISPER_MODEL_ID=whisper-1
