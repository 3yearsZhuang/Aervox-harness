{
  "name": "@aervox/desktop",
  "version": "0.2.0",
  "description": "Aervox Electron desktop UI and companion pet.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && node scripts/generate-icons.mjs && electron-vite dev",
    "build": "pnpm typecheck && node scripts/prepare-assets.mjs && node scripts/generate-icons.mjs && electron-vite build",
    "start": "electron-vite preview",
    "dist": "pnpm run build && pnpm run dist:pack",
    "dist:pack": "electron-builder --config electron-builder.yml",
    "dist:dir": "pnpm run build && electron-builder --dir --config electron-builder.yml",
    "test": "node scripts/prepare-assets.mjs && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json"
  },
  "keywords": [
    "electron",
    "vue",
    "typescript",
    "element-plus",
    "desktop-pet"
  ],
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@aervox/api-client": "workspace:*",
    "@aervox/live2d": "workspace:*",
    "@aervox/native-runtime": "workspace:*",
    "@aervox/plugin-companion-ui": "workspace:*",
    "@aervox/plugin-focus-mode": "workspace:*",
    "@aervox/plugin-panels-ui": "workspace:*",
    "@aervox/plugin-proactive-ui": "workspace:*",
    "@aervox/plugin-workbench-ui": "workspace:*",
    "@aervox/public": "workspace:*",
    "@aervox/ui": "workspace:*",
    "@aervox/ui-host": "workspace:*",
    "@sekai-world/pixi-live2d-display-mulmotion": "^0.5.1",
    "element-plus": "^2.11.5",
    "lucide-vue-next": "^0.468.0",
    "pixi.js": "^7.4.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@aervox/contracts": "workspace:^",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^43.7.9",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.12",
    "vite": "6.4.4"
  },
  "author": "3yearsZhuang"
}
