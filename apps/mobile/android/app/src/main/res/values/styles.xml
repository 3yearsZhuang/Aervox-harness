<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/runtime_primary</item>
        <item name="colorOnPrimary">@color/runtime_on_primary</item>
        <item name="colorPrimaryContainer">@color/runtime_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/runtime_on_primary_container</item>
        <item name="colorSecondary">@color/runtime_secondary</item>
        <item name="colorOnSecondary">@color/runtime_on_secondary</item>
        <item name="colorSecondaryContainer">@color/runtime_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/runtime_on_secondary_container</item>
        <item name="colorTertiary">@color/runtime_tertiary</item>
        <item name="colorOnTertiary">@color/runtime_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/runtime_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/runtime_on_tertiary_container</item>
        <item name="colorError">@color/runtime_error</item>
        <item name="colorOnError">@color/runtime_on_error</item>
        <item name="colorErrorContainer">@color/runtime_error_container</item>
        <item name="colorOnErrorContainer">@color/runtime_on_error_container</item>
        <item name="colorSurface">@color/runtime_surface</item>
        <item name="colorSurfaceVariant">@color/runtime_surface_variant</item>
        <item name="colorSurfaceBright">@color/runtime_surface_bright</item>
        <item name="colorSurfaceDim">@color/runtime_surface_dim</item>
        <item name="colorOnSurface">@color/runtime_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/runtime_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/runtime_surface_container</item>
        <item name="colorSurfaceContainerLowest">@color/runtime_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/runtime_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/runtime_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/runtime_surface_container_highest</item>
        <item name="colorOutline">@color/runtime_outline</item>
        <item name="colorOutlineVariant">@color/runtime_outline_variant</item>
        <item name="colorSurfaceInverse">@color/runtime_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/runtime_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/runtime_inverse_primary</item>
        <item name="android:colorBackground">@color/runtime_surface</item>
        <item name="android:windowBackground">@color/runtime_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/runtime_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/runtime_light_system_bars</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="textInputStyle">@style/Widget.Aervox.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Aervox.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Aervox.Dialog</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/runtime_surface</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/runtime_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/aervox_startup_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLightStatusBar">@bool/runtime_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/runtime_light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.Aervox.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Aervox.Input</item>
    </style>
    <style name="ShapeAppearance.Aervox.Input" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Widget.Aervox.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="ThemeOverlay.Aervox.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/runtime_surface_container_high</item>
        <item name="colorOnSurface">@color/runtime_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/runtime_on_surface_variant</item>
        <item name="textInputStyle">@style/Widget.Aervox.TextInputLayout</item>
    </style>
</resources>
