{
  "name": "@aervox/mobile",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Aervox Android project and shared mobile Web UI (ADR-022; local runtime pending).",
  "scripts": {
    "build": "pnpm run build:web",
    "build:web": "VITE_AERVOX_PLATFORM=mobile pnpm --filter @aervox/web build",
    "dev": "VITE_AERVOX_PLATFORM=mobile pnpm --filter @aervox/web dev",
    "preview": "pnpm --filter @aervox/web start",
    "cap:sync": "cap sync",
    "cap:sync:web": "cap sync web",
    "cap:sync:android": "pnpm run build:web && cap sync android",
    "cap:doctor": "cap doctor android",
    "android:check": "node scripts/check-android-environment.mjs",
    "android:check:device": "node scripts/check-android-environment.mjs --device",
    "android:build": "node scripts/build-android.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@aervox/web": "workspace:*",
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1"
  }
}
