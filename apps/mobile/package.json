{
  "name": "@aervox/mobile",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "Aervox Capacitor mobile shell (packages apps/web, see ADR-015).",
  "scripts": {
    "build": "VITE_AERVOX_PLATFORM=mobile pnpm --filter @aervox/web build && cap sync web",
    "dev": "VITE_AERVOX_PLATFORM=mobile pnpm --filter @aervox/web dev",
    "preview": "cap serve web",
    "cap:sync": "cap sync",
    "cap:sync:web": "cap sync web",
    "cap:doctor": "cap doctor"
  },
  "dependencies": {
    "@aervox/web": "workspace:*",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
