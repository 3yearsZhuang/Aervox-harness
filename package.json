{
  "name": "aervox-harness",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@aervox/api --filter=@aervox/desktop",
    "dev:cli": "./aervox dev cli",
    "dev:web": "turbo run dev --filter=@aervox/api --filter=@aervox/web",
    "cli": "./aervox cli",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=2",
    "test:affected": "node scripts/test-affected.mjs",
    "test:unit": "turbo run test --filter=@aervox/core --filter=@aervox/practice-review --filter=@aervox/config --filter=@aervox/observability --filter=@aervox/contracts --filter=@aervox/api-client --filter=@aervox/diary --filter=@aervox/ui --filter=@aervox/ui-host --filter=@aervox/desktop --filter=./surfaces/* --filter=./plugins/*",
    "test:guards": "node --test scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --project=api",
    "test:e2e:ui": "playwright test --project=ui",
    "check:boundary": "node scripts/import-boundary.mjs && node --test scripts/import-boundary.test.mjs",
    "check:ci-config": "node --test scripts/ci-scope.test.mjs",
    "check:artifacts": "pnpm --filter @aervox/contracts build && node --test scripts/export-plugins.test.mjs",
    "check:guards": "node --test scripts/check-*.test.mjs && node scripts/check-banned-identifiers.mjs && node scripts/check-host-domain-purity.mjs && node scripts/check-type-boundary.mjs && node scripts/check-dep-hoisting.mjs && node scripts/check-removable-implementation.mjs && node scripts/check-tracked-files.mjs",
    "package:plugins": "pnpm --filter @aervox/contracts build && node scripts/export-plugins.mjs",
    "drill:worker-contention": "node scripts/worker-write-contention-drill.mjs",
    "dist:desktop": "turbo run native:build --filter=@aervox/native-runtime && turbo run build --filter=@aervox/desktop && pnpm --filter @aervox/desktop dist:pack",
    "test:cli:integration": "turbo run build --filter=@aervox/cli --filter=@aervox/api && node --test scripts/cli-smoke.test.mjs",
    "check:hls": "turbo run build --filter=@aervox/core... && node --test scripts/hls-agent.test.mjs",
    "check:memory-deletion": "turbo run build --filter=@aervox/worker... && node --test scripts/memory-deletion-research/runner.test.mjs scripts/memory-deletion-research/supplement.test.mjs",
    "check:dependency-audit": "node scripts/check-dependency-audit.mjs",
    "plugin": "pnpm --filter @aervox/contracts build && node scripts/plugin-cli.mjs",
    "check:standards": "node --test scripts/plugin-cli.test.mjs scripts/openapi-compat.test.mjs && node scripts/plugin-cli.mjs check --all && node scripts/openapi-compat.mjs",
    "update:api-baseline": "node scripts/openapi-compat.mjs --update",
    "check:deletion-fault-testing": "turbo run build --filter=@aervox/worker... && node --test scripts/deletion-fault-testing/*.test.mjs",
    "check:deletion-fault-integration": "turbo run build --filter=@aervox/worker... && pnpm --filter @aervox/research-deletion-fault-testing test:integration"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@playwright/test": "1.62.1",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "happy-dom": "^20.14.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.5",
    "sqlite-vec": "0.1.7",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "@aervox/research-deletion-fault-testing": "workspace:*"
  },
  "dependencies": {
    "@aervox/native-runtime": "workspace:*",
    "@vscode/ripgrep": "1.18.0",
    "qrcode": "1.5.4",
    "ws": "8.21.3"
  }
}
