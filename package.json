{
  "name": "aervox-harness",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@aervox/api --filter=@aervox/desktop",
    "dev:web": "turbo run dev --filter=@aervox/api --filter=@aervox/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "check:boundary": "node scripts/import-boundary.mjs && node --test scripts/import-boundary.test.mjs",
    "dist:desktop": "turbo run build --filter=@aervox/desktop && pnpm --filter @aervox/desktop dist:pack"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@playwright/test": "1.62.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.0.18"
  }
}
