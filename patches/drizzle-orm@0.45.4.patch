@@ -34,10 +34,12 @@ class DrizzleError extends Error {
 }
 class DrizzleQueryError extends Error {
   constructor(query, params, cause) {
-    super(`Failed query: ${query}
-params: ${params}`);
-    this.query = query;
-    this.params = params;
+    super("Database query failed");
+    // Aervox: SQL and bound values must not enter API responses or ordinary logs.
